PORT=5001
MONGO_URI=mongodb://username:password@host/database
JWT_SECRET=replace_with_a_long_random_secret_min_32_chars
STAFF_CODE=replace_with_a_secret_staff_registration_code
CORS_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:5001

# Razorpay (test mode keys from https://dashboard.razorpay.com/app/keys — never commit real values)
RAZORPAY_KEY_ID=replace_with_razorpay_key_id
RAZORPAY_KEY_SECRET=replace_with_razorpay_key_secret
# From the webhook's settings page in the Razorpay dashboard, after adding the webhook URL
RAZORPAY_WEBHOOK_SECRET=replace_with_razorpay_webhook_secret